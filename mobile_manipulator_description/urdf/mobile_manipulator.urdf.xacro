<?xml version="1.0" ?>
<robot name="robot" xmlns:xacro="http://ros.org/wiki/xacro">
  <!-- RS005L makrosu -->
  <xacro:include filename="$(find mobile_manipulator_description)/urdf/khi_rs/rs005l_macro.xacro"/>
  <xacro:arg name="use_fake_hardware" default="false" />
  <xacro:arg name="tf_prefix" default="" />
  <xacro:arg name="sim_ignition" default="false" />
  <xacro:arg name="simulation_controllers" default="" />
  <xacro:arg name="name" default="rs005l" />
  <!-- AGV / OTA makroları -->
  <!-- <xacro:include filename="$(find mobile_manipulator_description)/urdf/ota/ota_base.xacro"/> -->
  
  <!-- <xacro:include filename="$(find mobile_manipulator_description)/urdf/ota/inertia_tensors.urdf.xacro"/>
  <xacro:include filename="$(find mobile_manipulator_description)/urdf/ota/ota_wheel.xacro"/>
  <xacro:include filename="$(find mobile_manipulator_description)/urdf/ota/ota_plugin.xacro"/>
  <xacro:include filename="$(find mobile_manipulator_description)/urdf/ota/ota_caster.xacro"/>
  <xacro:include filename="$(find mobile_manipulator_description)/urdf/ota/ota_ir.xacro"/> -->
  <xacro:include filename="$(find mobile_manipulator_description)/urdf/ota/ota_macro.xacro"/>
     <!-- Simulation parameters -->
   <xacro:arg name="use_fake_hardware" default="false" />
   <xacro:arg name="sim_ignition" default="false" />
   <xacro:arg name="simulation_controllers" default="" />

   <xacro:property name="is_sim_ignition" value="$(arg sim_ignition)"/>
  <!-- instantiate rs005l -->
  <xacro:ota_macro
      base_link="ota_base_link"
      name="ota_system"
      sim_ignition="$(arg sim_ignition)"
      use_fake_hardware="$(arg use_fake_hardware)"
      generate_ros2_control_tag="true"/>
      
  <!-- AGV'nin hareket edebilmesi için world bağlantısı KALDIRILDI -->
  <!-- Eğer sabit başlangıç pozisyonu istiyorsanız, spawn sırasında -x -y -z parametreleri kullanın -->
  <!-- instantiate ota -->
  <!-- <xacro:ota_base link_name="ota_base_link"/>
  <xacro:ota_ir base_link="ota_base_link" link_name="ota_ir" xyz_ir="0.503 0.0 0.175" rpy_ir="0 0 0"/>
  <xacro:ota_wheel base_link="ota_base_link" xyz_hub="0 -0.30 0.10" rpy_hub="0 0 0" side="left"/>
  <xacro:ota_wheel base_link="ota_base_link" xyz_hub="0 0.30 0.10" rpy_hub="0 0 0" side="right"/>
  <xacro:ota_swivel base_link="ota_base_link" xyz_caster="0.37 -0.22 0.12" rpy_caster="0 0 0" side="front_right"/>
  <xacro:ota_swivel base_link="ota_base_link" xyz_caster="0.37 0.22 0.12" rpy_caster="0 0 0" side="front_left"/>
  <xacro:ota_swivel base_link="ota_base_link" xyz_caster="-0.37 -0.22 0.12" rpy_caster="0 0 0" side="back_right"/>
  <xacro:ota_swivel base_link="ota_base_link" xyz_caster="-0.37 0.22 0.12" rpy_caster="0 0 0" side="back_left"/>
  <xacro:ota_diff_drive base_link="ota_base_link"/>
  <xacro:ota_joints_state_publisher /> -->

  <xacro:khi_rs005l 
    name="$(arg name)"
    tf_prefix="$(arg tf_prefix)"
    parent="manipulator_base_link"
    sim_ignition="$(arg sim_ignition)"
    use_fake_hardware="$(arg use_fake_hardware)">
    <origin xyz="0 0 0.051" rpy="0 0 3.141593" />
  </xacro:khi_rs005l>

  <xacro:if value="$(arg sim_ignition)">
    <!-- Kawasaki robot arm controller -->
    <gazebo>
      <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
        <parameters>$(arg simulation_controllers)</parameters>
        <controller_manager_node_name>$(arg tf_prefix)controller_manager</controller_manager_node_name>
        <ros>
          <namespace>kawasaki</namespace>
        </ros>
      </plugin>
    </gazebo>
    
    <!-- OTA AGV diff drive controller (ayrı plugin) -->
    <gazebo>
      <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
        <parameters>$(find mobile_manipulator_description)/config/ota_controllers.yaml</parameters>
        <controller_manager_node_name>ota_controller_manager</controller_manager_node_name>
      </plugin>
    </gazebo>
  </xacro:if>

</robot>
