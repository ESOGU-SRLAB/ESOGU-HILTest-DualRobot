<?xml version="1.0"?>
<robot name="ota_macros" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- Inertia helper macros -->
  <property name="M_PI" value="3.1415926535897931" />

  <!-- see https://secure.wikimedia.org/wikipedia/en/wiki/List_of_moment_of_inertia_tensors -->

  <!-- #################### versions without origin #################### -->
  <xacro:macro name="sphere_inertial" params="radius mass">
    <inertial>
      <mass value="${mass}" />
      <origin xyz="0 0 0" />
      <inertia ixx="${0.4 * mass * radius * radius}" ixy="0.0" ixz="0.0"
        iyy="${0.4 * mass * radius * radius}" iyz="0.0"
        izz="${0.4 * mass * radius * radius}" />
    </inertial>
  </xacro:macro>

  <xacro:macro name="sphere_inertial_with_origin" params="radius mass *origin">
    <inertial>
      <mass value="${mass}" />
      <insert_block name="origin" />
      <inertia ixx="${0.4 * mass * radius * radius}" ixy="0.0" ixz="0.0"
        iyy="${0.4 * mass * radius * radius}" iyz="0.0"
        izz="${0.4 * mass * radius * radius}" />
    </inertial>
  </xacro:macro>

  <xacro:macro name="cylinder_inertial" params="radius length mass">
    <inertial>
      <mass value="${mass}" />
      <origin xyz="0 0 0" />
      <inertia ixx="${(1/12.0) * mass * (3 * radius * radius + length * length)}" ixy="0.0" ixz="0.0"
        iyy="${(1/12.0) * mass * (3 * radius * radius + length * length)}" iyz="0.0"
        izz="${0.5 * mass * radius * radius}" />
    </inertial>
  </xacro:macro>

  <xacro:macro name="cylinder_inertial_with_origin" params="radius length mass *origin">
    <inertial>
      <mass value="${mass}" />
      <insert_block name="origin" />
      <inertia ixx="${(1/12.0) * mass * (3 * radius * radius + length * length)}" ixy="0.0" ixz="0.0"
        iyy="${(1/12.0) * mass * (3 * radius * radius + length * length)}" iyz="0.0"
        izz="${0.5 * mass * radius * radius}" />
    </inertial>
  </xacro:macro>

  <xacro:macro name="box_inertial" params="x y z mass">
    <inertial>
      <mass value="${mass}" />
      <origin xyz="0 0 0" />
      <inertia ixx="${0.0833333 * mass * (y*y + z*z)}" ixy="0.0" ixz="0.0"
        iyy="${0.0833333 * mass * (x*x + z*z)}" iyz="0.0"
        izz="${0.0833333 * mass * (x*x + y*y)}" />
    </inertial>
  </xacro:macro>

  <xacro:macro name="box_inertial_with_origin" params="x y z mass *origin">
    <inertial>
      <mass value="${mass}" />
      <insert_block name="origin" />
      <inertia ixx="${0.0833333 * mass * (y*y + z*z)}" ixy="0.0" ixz="0.0"
        iyy="${0.0833333 * mass * (x*x + z*z)}" iyz="0.0"
        izz="${0.0833333 * mass * (x*x + y*y)}" />
    </inertial>
  </xacro:macro>

  <!-- OTA base geometry & collision -->
  <xacro:macro name="ota_base" params="link_name">

    <link name='${link_name}'>
      <origin xyz="0 0 0" rpy=" 0 0 0"/>
      
      <visual>
        <origin xyz="0 0 0" rpy=" 0 0 0"/>
        <geometry>
          <mesh filename="file:////home/cem/colcon_ws/src/mobile_manipulator_description/meshes/ota/OTA-v0.7.stl" scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="DefaultWhite">
          <color rgba="1 1 1 1"/>
        </material>
      </visual>    
      
      <collision>
        <origin xyz="0 0 0" rpy=" 0 0 0"/>
        <geometry>
          <mesh filename="file:////home/cem/colcon_ws/src/mobile_manipulator_description/meshes/ota/OTA-v0.7.stl" scale="0.001 0.001 0.001"/>
        </geometry>
      </collision>

      <!-- basit inertial (istersen box_inertial ile değiştirirsin) -->
      <inertial>
        <mass value="50.0"/>
        <origin xyz="0 0 0"/>
        <inertia ixx="1" iyy="1" izz="1" ixy="0" ixz="0" iyz="0"/>
      </inertial>

    </link>

    <link name='manipulator_base_link'>
      <origin xyz="0 0 0" rpy=" 0 0 0"/>
      
      <visual>
        <origin xyz="0 0 -0.0" rpy=" 0 0 0"/>
        <geometry>
          <box size="0.187945 0.190701 0.103"/>
        </geometry>
      </visual>    
      
      <collision>
        <origin xyz="0 0 -0.0" rpy=" 0 0 0"/>
        <geometry>
          <box size="0.187945 0.190701 0.103"/>
        </geometry>
      </collision>    
    
      <xacro:box_inertial x="0.187945" y="0.190701"  z="0.103" mass="5.0" />
    </link>

    <gazebo reference="manipulator_base_link">
      <material value="Gazebo/Orange"/>
    </gazebo>

    <joint name="base2manipulatorbase" type="fixed">
      <parent link="${link_name}"/>
      <child link="manipulator_base_link"/>
      <origin rpy="0 0 0" xyz="0.001 -0.26 0.377"/>
    </joint>

  </xacro:macro>

  <!-- OTA drive wheels -->
  <xacro:macro name="ota_wheel" params="base_link xyz_hub rpy_hub side">

    <!-- === WHEEL VISUAL === -->
    <link name="wheel_${side}_link">

      <visual>
        <origin xyz="0 0 0" rpy="0 0 1.570796"/>
        <geometry>
          <mesh filename="file:////home/cem/colcon_ws/src/mobile_manipulator_description/meshes/ota/AnaTeker.stl"
                scale="0.001 0.001 0.001"/>
        </geometry>
      </visual>

      <!-- === WHEEL COLLISION (simple cylinder) === -->
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="0.102" length="0.02"/>
        </geometry>
      </collision>

      <!-- === WHEEL INERTIA === -->
      <xacro:cylinder_inertial radius="0.102" length="0.02" mass="5"/>
    </link>

    <!-- === WHEEL JOINT === -->
    <joint name="wheel_${side}_base" type="continuous">
      <origin xyz="${xyz_hub}" rpy="${rpy_hub}"/>
      <parent link="${base_link}"/>
      <child link="wheel_${side}_link"/>
      <axis xyz="0 1 0"/>
    </joint>

  </xacro:macro>

  <!-- OTA caster wheels -->
  <xacro:macro name="ota_swivel" params="base_link xyz_caster rpy_caster side">
	  
    <!-- CASTER BODY -->
    <link name='caster_${side}_link'>
      <visual>
        <origin xyz="0 0 0"/>
        <geometry>
          <mesh filename="file:////home/cem/colcon_ws/src/mobile_manipulator_description/meshes/ota/SarhosTeker.stl"
                scale="0.001 0.0008 0.001"/>
        </geometry>
      </visual>

      <collision>
        <origin xyz="0 0 0"/>
        <geometry>
          <cylinder radius="0.04" length="0.02"/>
        </geometry>
      </collision>

      <xacro:cylinder_inertial radius="0.04" length="0.02" mass="0.5" />
    </link>   
    <!-- Bu joint continous'tu -->
    <joint name="caster_${side}_joint" type="fixed">
      <axis xyz="0 0 1"/>
      <origin xyz="${xyz_caster}" rpy="${rpy_caster}"/>
      <child link="caster_${side}_link"/>
      <parent link="${base_link}"/>
    </joint>  

    <link name='caster_wheel_${side}_link'>
      <visual>
        <origin xyz="0 0 0"/>
        <geometry>
          <cylinder radius="0.042" length="0.02"/>
        </geometry>
      </visual>

      <collision>
        <origin xyz="0 0 0"/>
        <geometry>
          <cylinder radius="0.042" length="0.02"/>
        </geometry>
      </collision>

      <xacro:cylinder_inertial radius="0.042" length="0.02" mass="0.1" />
    </link>      
    
    <joint name="caster_${side}_wheel_joint" type="fixed">
      <axis xyz="0 1 0"/>
      <origin xyz="-0.04 0 -0.07"/>
      <parent link="caster_${side}_link"/>
      <child link="caster_wheel_${side}_link"/>
    </joint>  
  
  </xacro:macro>

  <!-- OTA IR sensor -->
  <xacro:macro name="ota_ir" params="base_link link_name xyz_ir rpy_ir">

    <link name="${link_name}_link">

      <!-- Inertial -->
      <inertial>
        <mass value="0.001"/>
        <origin xyz="0 0 0"/>
        <inertia ixx="0.001666" iyy="0.001666" izz="0.001666"
                 ixy="0" ixz="0" iyz="0"/>
      </inertial>

      <!-- Visual -->
      <visual>
        <origin xyz="0 0 0"/>
        <geometry>
          <box size="0.02 0.02 0.02"/>
        </geometry>
      </visual>

      <!-- Collision -->
      <collision>
        <origin xyz="0 0 0"/>
        <geometry>
          <box size="0.02 0.02 0.02"/>
        </geometry>
      </collision>

      <!-- Gazebo sensor plugin (IR/Range) -->
      <gazebo reference="${link_name}_link">
        <sensor name="${link_name}_sensor" type="ray">
          <always_on>true</always_on>
          <update_rate>20</update_rate>
          <pose>0 0 0 0 0 0</pose>
          <visualize>true</visualize>
        </sensor>
      </gazebo>

    </link>

    <joint name="${link_name}_joint" type="fixed">
      <origin xyz="${xyz_ir}" rpy="${rpy_ir}"/>
      <parent link="${base_link}"/>
      <child link="${link_name}_link"/>
    </joint>

  </xacro:macro>

  <!-- High-level macro: creates full OTA AGV (base, wheels, casters, IR, plugins) -->
  <xacro:macro name="ota_macro" params="
    base_link:=ota_base_link
    name
    use_fake_hardware:=false
    sim_ignition:=false
    generate_ros2_control_tag:=true
    ">
    <xacro:if value="${generate_ros2_control_tag}">
      <!-- ros2 control include -->
      <xacro:include filename="$(find mobile_manipulator_description)/urdf/ota/ota.ros2_control.xacro" />
      <!-- ros2 control instance -->
      <xacro:ota_ros2_control
        name="${name}"
        use_fake_hardware="${use_fake_hardware}"
        sim_ignition="${sim_ignition}"
      />
    </xacro:if> 
    <!-- AGV gövdesi -->
    <xacro:ota_base link_name="${base_link}"/>

    <!-- IR sensör -->
    <xacro:ota_ir base_link="${base_link}" link_name="ota_ir" xyz_ir="0.503 0.0 0.175" rpy_ir="0 0 0"/>

    <!-- Tahrik tekerlekleri -->
    <xacro:ota_wheel base_link="${base_link}" xyz_hub="0 -0.30 0.10" rpy_hub="0 0 0" side="left"/>
    <xacro:ota_wheel base_link="${base_link}" xyz_hub="0 0.30 0.10" rpy_hub="0 0 0" side="right"/>

    <!-- Sarhoş tekerlekler -->
    <xacro:ota_swivel base_link="${base_link}" xyz_caster="0.37 -0.22 0.12" rpy_caster="0 0 0" side="front_right"/>
    <xacro:ota_swivel base_link="${base_link}" xyz_caster="0.37 0.22 0.12" rpy_caster="0 0 0" side="front_left"/>
    <xacro:ota_swivel base_link="${base_link}" xyz_caster="-0.37 -0.22 0.12" rpy_caster="0 0 0" side="back_right"/>
    <xacro:ota_swivel base_link="${base_link}" xyz_caster="-0.37 0.22 0.12" rpy_caster="0 0 0" side="back_left"/>
  </xacro:macro>

</robot>
