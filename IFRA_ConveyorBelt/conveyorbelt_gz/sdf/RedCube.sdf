<?xml version="1.0"?>
<sdf version="1.8">

  <model name="RedCube">
    <static>false</static>

    <link name="RedCube">

      <pose>0 0 0 0 0 0</pose>
      <self_collide>false</self_collide>

      <inertial>
        <mass>0.1</mass>
        <inertia>
          <ixx>0.000015</ixx>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyy>0.000015</iyy>
          <iyz>0.0</iyz>
          <izz>0.000015</izz>
        </inertia>
      </inertial>

      <collision name="RedCube_collision">

        <pose>0 0 0 0 0 0</pose>

        <geometry>
          <mesh>
            <uri>model://conveyorbelt_gz/meshes/objects/RedCube.dae</uri>
          </mesh>
        </geometry>

      </collision>

      <visual name="RedCube_visual">

        <pose>0 0 0 0 0 0</pose>

        <geometry>
          <mesh>
            <uri>model://conveyorbelt_gz/meshes/objects/RedCube.dae</uri>
          </mesh>
        </geometry>

      </visual>

    </link>

    <!-- ObjectPose plugin (libros2_objectpose_plugin.so) not built in this workspace -->
    <!-- Uncomment if you have the plugin available:
    <plugin name="ros2_objectpose_plugin" filename="libros2_objectpose_plugin.so">
      <topic>RedCube/ObjectPose</topic>
      <object_name>RedCube</object_name>
    </plugin>
    -->

  </model>
</sdf>