  <!-- cem.sdf: ifarlab_ray model pose = "0 0 0 0 0 0" → world origin -->
  <joint name="ifarlab_ray_joint" type="fixed">
    <parent link="world"/>
    <child link="ifarlab_ray_link"/>
    <origin rpy="0 0 0" xyz="0 0 0"/>
  </joint>
  <!-- AGV başlangıç konumu: cem.sdf spawn pozisyonundan okundu
         x=-2.301949  y=0.135135131  z=0.17  yaw=1.570796 (90°)
         axis 1 0 0 = joint frame local X = yaw 90° nedeniyle world +Y yönü
         Bu eksende AGV ileri/geri hareket eder (ray üzerinde kayar) -->
  <joint name="world_to_agv" type="prismatic">
    <parent link="ifarlab_ray_link"/>
    <child link="ota_base_link"/>
    <origin rpy="0 0 1.570796" xyz="-2.301959 0.135135131 0.165"/>
    <axis xyz="1.0 0.0 0.0"/>
    <limit effort="1000" lower="0.0" upper="2.0" velocity="1.25"/>
    <dynamics damping="100.0" friction="50.0"/>
  </joint>
  <joint name="base2manipulatorbase" type="fixed">
    <parent link="ota_base_link"/>
    <child link="manipulator_base_link"/>
    <origin rpy="0 0 0" xyz="0.001 -0.26 0.212"/>
  </joint>
  <ros2_control name="ota_system" type="system">
    <hardware>
      <plugin>mock_components/GenericSystem</plugin>
      <param name="fake_sensor_commands">False</param>
      <param name="state_following_offset">0.0</param>
    </hardware>
    <!-- Right wheel -->
    <joint name="wheel_right_base">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <!-- Left wheel -->
    <joint name="wheel_left_base">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>
  <link name="ota_ir_link">
